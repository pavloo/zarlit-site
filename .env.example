# Credentials for the local admin tool (npm run admin). Copy to .env, which is
# gitignored. CI never needs these: the deploy only builds HTML.
#
# Create an R2 API token scoped to this one bucket:
# Cloudflare dashboard → R2 → Manage R2 API Tokens → Object Read & Write.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zarlit-files
