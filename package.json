{
  "name": "zarlit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content": "node scripts/build-content.ts",
    "build": "npm run content && tsc -b && vite build && npm run build:ssr && node scripts/prerender.ts",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "lint": "oxlint",
    "preview": "vite preview",
    "og": "./scripts/make-og.sh",
    "admin": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config admin/vite.config.ts",
    "desktop:renderer": "vite build --config admin/vite.config.ts --outDir ../desktop/dist/renderer --emptyOutDir",
    "desktop:main": "vite build --config desktop/vite.config.ts",
    "desktop:build": "npm run desktop:renderer && npm run desktop:main",
    "desktop": "npm run desktop:build && electron desktop/dist/main.cjs",
    "desktop:dist": "npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.37.0",
    "markdown-it": "^15.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "express": "^5.2.1",
    "isomorphic-git": "^1.42.5",
    "multer": "^2.4.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tiptap-markdown": "^0.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "main": "desktop/dist/main.cjs"
}
